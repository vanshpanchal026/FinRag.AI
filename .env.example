# FinRAG-Eval Environment Configuration
# Copy this file to .env and fill in your API keys

# LLM Providers (Groq Cloud is recommended for free high-speed inference)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_or_custom_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Models
MAIN_AGENT_MODEL=llama-3.3-70b-versatile
EVAL_AGENT_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# Chunking Parameters
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
MAX_TABLE_TOKENS=1500
MAX_CONCALL_TOKENS=700
